    <connection>constantine_db</connection>
    <sql>SELECT
    th.trx_reference AS  transaction_id_source,
    th.trx_date AS date_vente,
    th.trx_time AS heure_transaction,
    s.store_code AS code_magasin,
    th.register_id AS numero_caisse,
    c.customer_code AS code_client,
    p.product_sku AS code_produit,
    th.payment_method AS mode_paiement,
    tl.quantity AS quantite_vendue,
    tl.unit_price AS montant_unitaire_ttc,
    tl.line_total AS montant_ligne_ttc,
    tl.vat_rate AS taux_tva,
    tl.line_discount AS montant_remise,
    th.loyalty_points_earned AS  points_fidelite_gagnes,
    th.trx_status AS statut_transaction
FROM trx_headers th
INNER JOIN trx_lines tl ON th.trx_id = tl.trx_id
INNER JOIN stores s ON th.store_id = s.store_id
LEFT JOIN customers c ON th.customer_id = c.customer_id
INNER JOIN products p ON tl.product_id = p.product_id
WHERE th.trx_status = 'COMPLETED'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
