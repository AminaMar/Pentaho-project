  <step>
    <name>Extraction depuis table</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>constantine_db</connection>
    <sql>SELECT DISTINCT
    -- paiement_key : AUTO_INCREMENT (ne pas sélectionner)
    
    -- code_paiement
    CONCAT('CST-', payment_method) AS code_paiement,
    
    -- mode_paiement
    payment_method AS mode_paiement,
    
    -- type_paiement
    CASE 
        WHEN payment_method IN ('CREDIT_CARD', 'DEBIT_CARD') THEN 'CARD'
        WHEN payment_method = 'CASH' THEN 'CASH'
        WHEN payment_method = 'MOBILE' THEN 'MOBILE'
        WHEN payment_method = 'CHECK' THEN 'CHECK'
        ELSE 'OTHER'
    END AS type_paiement,
    
    -- description_mode
    CASE 
        WHEN payment_method = 'CREDIT_CARD' THEN 'Paiement par carte de crédit'
        WHEN payment_method = 'DEBIT_CARD' THEN 'Paiement par carte de débit'
        WHEN payment_method = 'CASH' THEN 'Paiement en espèces'
        WHEN payment_method = 'MOBILE' THEN 'Paiement mobile'
        WHEN payment_method = 'CHECK' THEN 'Paiement par chèque'
        ELSE 'Autre mode de paiement'
    END AS description_mode,
    
    -- montant_paye
    amount AS montant_paye,
    
    -- numero_carte
    CASE 
        WHEN card_last_four IS NOT NULL THEN CONCAT('****', card_last_four)
        ELSE NULL
    END AS numero_carte,
    
    -- code_autorisation
    authorization_code AS code_autorisation

FROM constantine_db.payments
WHERE payment_status = 'APPROVED'
ORDER BY payment_method;</sql>
