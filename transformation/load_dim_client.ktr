  <step>
    <name>Input_Constantine_MySQL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>constantine_db</connection>
    <sql>SELECT 
    customer_code,
    first_name,
    last_name,
    email,
    phone,
    city,
    registration_date,
    loyalty_card_number,
    customer_segment,
    total_purchases,
    status
FROM customers
WHERE status = 'ACTIVE'</sql>
