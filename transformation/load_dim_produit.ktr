  <step>
    <name>constantine_produits_sql</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>constantine_db</connection>
    <sql>SELECT 
    product_sku,
    product_name,
    product_description,
    barcode,
    brand,
    category_name,
    parent_category_name,
    unit_price,
    cost_price,
    vat_rate,
    unit_of_measure,
    weight,
    is_active AS status
FROM (
    SELECT 
        p.product_sku,
        p.product_name,
        p.product_description,
        p.barcode,
        p.brand,
        c.category_name,
        pc.category_name AS parent_category_name,
        p.unit_price,
        p.cost_price,
        p.vat_rate,
        p.unit_of_measure,
        p.weight,
        p.is_active
    FROM products p
    LEFT JOIN categories c ON p.category_id = c.category_id
    LEFT JOIN categories pc ON c.parent_category_id = pc.category_id
) AS sub
WHERE is_active = TRUE;
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
